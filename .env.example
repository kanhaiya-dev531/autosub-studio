# Copy this file to ".env" and change what you need. Lines starting with # are comments.
# Every setting has a default, so an empty .env also works (SQLite + local Whisper).

# ---- where files are kept ----------------------------------------------------
# Uploaded videos, previews, rendered videos and the SQLite file live here.
# DATA_DIR=./data

# ---- database ------------------------------------------------------------------
# Leave DB_HOST empty to use a SQLite file (easiest for a first run).
# Fill these in to use MySQL (local, Docker, XAMPP, or a free cloud MySQL):
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autosub
# Cloud databases (TiDB Cloud, Aiven) require an encrypted connection:
# DB_SSL=true
# DB_SSL_CA=            # optional path to a CA file; the built-in certificate list is used when empty

# ---- speech recognition ------------------------------------------------------------
# local = faster-whisper on this computer (free, private, needs a few hundred MB of RAM)
# groq  = Groq's hosted Whisper (free tier, no model on your server; used for the online deployment)
TRANSCRIBER=local
# tiny, base, small, medium (bigger = more accurate and slower). 'small' is the minimum for good Hindi.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# ---- limits (useful on a small free server) ------------------------------------------------
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=0         # 0 = no limit
RENDER_MAX_HEIGHT=0         # 0 = keep the original size; 480 or 720 makes rendering much faster
WORKERS=1                   # videos processed at the same time
JOB_TTL_HOURS=0             # delete projects after this many hours; 0 = keep them

# ---- website ------------------------------------------------------------------------------------
# A long random text that signs login cookies. If empty, one is created in DATA_DIR.
SECRET_KEY=
# Set to true once the site is served over HTTPS (it is, on Render).
SESSION_COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000

# ---- tools ---------------------------------------------------------------------------------------
# Only needed when FFmpeg is not on your PATH:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
